    <limit effort="300" lower="-2.96555" upper="2.35619" velocity="10"/>
    <axis xyz="0 -1 0"/>
    <origin xyz="0.050 0 0.4031" rpy="0 0 0"/>
  </joint>
  <transmission name="tran3">
